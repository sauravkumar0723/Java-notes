Key Points to Remember

. Exception handling helps your program deal with unexpected errors (like missing files or read/write problems)
without crashing.
. Always use a try-catch block when working with files.
. Catch specific exceptions first - like FileNotFoundException before a general IOException .
. Use the finally block (or try-with-resources ) to close the file and release resources - even if something goes
wrong.
. Show clear and friendly messages to the user when an error occurs.


# BufferReader & BufferWriter


package com.FileHandling_lect2;

import java.io.FileReader;
import java.io.FileWriter;

public class Demo1 {
	public static void main(String[] args) {
		
		String path1 = "C:\\Users\\Saurav Kumar\\OneDrive\\Documents\\JAVA\\FileHandling\\input.txt";
		String path2 = "C:\\Users\\Saurav Kumar\\OneDrive\\Documents\\JAVA\\FileHandling\\output.txt";
		
		FileReader fr = null;
		FileWriter fw = null;
		try {
		   fr = new FileReader(path1);
		   fw = new FileWriter(path2);
		   int data;
		   while((data = fr.read())!=-1)
		   {
			  fw.write(data);
		   }
		} 
		catch (Exception e) {
			e.printStackTrace();
		}
		finally {
			try {
				if(fr != null) fr.close();
				if(fw != null) fw.close();
			} catch (Exception e2) {
				e2.printStackTrace();
			}
		}
	}
}
