####  Ascending Order Sorting
public class AscendingSort {
    public static void main(String[] args) {
        int[] arr = {5, 2, 9, 1, 6};
        for (int i = 0; i < arr.length - 1; i++) {
            for (int j = 0; j < arr.length - 1 - i; j++) {
                if (arr[j] > arr[j + 1]) {
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }
        }
        System.out.print("Sorted Array: ");
        for (int x : arr) {
            System.out.print(x + " ");
        }
    }
}
 Output
Sorted Array: 1 2 5 6 9
