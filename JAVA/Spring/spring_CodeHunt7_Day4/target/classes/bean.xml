         </bean> -->
         
         <!-- 5. complex bean with some logic -->
         
         <bean id="acc" class="com.codeHunt.spring_CodeHunt1.Account"></bean>
         
         <bean id="ObjectFactory" class="com.codeHunt.spring_CodeHunt1.ObjectFactory">
         
         <property name="account" ref="acc"></property>
         
         </bean>
         <bean id="emp" factory-bean="ObjectFactory" factory-method="getObject"></bean>
         
</beans>