Singleton Scope (Default)
Definition:
In singleton scope, Spring creates only one instance of the bean per container.
Every call to getBean() for that bean returns the same object.
Key Points:
Default scope in Spring
Object is created when container starts (unless lazy-init=true)
Constructor runs only once
Example:
<bean id="emp" class="Employee" scope="singleton"/>
Employee e1 = (Employee) ac.getBean("emp");
Employee e2 = (Employee) ac.getBean("emp");


Prototype Scope
Definition:
In prototype scope, Spring creates a new instance of the bean every time getBean() is called.
Key Points:
Every getBean() → new object
Constructor runs every time
lazy-init is ignored because object is created on demand
Example:

<bean id="emp" class="Employee" scope="prototype"/>
Employee e1 = (Employee) ac.getBean("emp");
Employee e2 = (Employee) ac.getBean("emp");


package com.codeHunt.spring_CodeHunt1;

import org.springframework.context.support.ClassPathXmlApplicationContext;

public class Employee {
	private int test;
	static {
		System.out.println("emp bean loading");
	}
	public Employee() {
		System.out.println("Employee been Instantiated");
	}
	public void test() {
		System.out.println("Emp tested........." + test);
	}
	public int getTest() {
		return test;
	}
	public void setTest(int test) {
		this.test = test;
	}
}

package com.codeHunt.spring_CodeHunt1;

import org.springframework.context.support.ClassPathXmlApplicationContext;

public class Launch {
	public static void main(String[] args) {
		ClassPathXmlApplicationContext ac = new ClassPathXmlApplicationContext("bean.xml");
		
		
//		2️ id="emp"
//
//				This is the bean name (bean id).
//
//				You use this id to get the object from the container.
		
		Employee emp1 = (Employee) ac.getBean("emp");
		emp1.setTest(1000);
		emp1.test();
		
		
//		getBean() is a method of Spring container
//
//		"emp" is the bean id written in bean.xml
		
		Employee emp2 = (Employee) ac.getBean("emp");
//		emp2.setTest(1000);
		emp2.test();
	}
}

